{
  "name": "patsnap-patent-skill-suite",
  "description": "中国专利全流程技能套件（智慧芽 MCP 增强）：交底书编写、申请文件生成、著录检索、专利解读、审查答复、政策简报、全景分析与 FTO 风险检索。基于 handsomestWei/patent-disclosure-skill 衍生，接入智慧芽 MCP 工具链替代 Playwright 爬虫。",
  "version": "1.1.0",
  "runtime": {
    "python_version": "3.12",
    "dependencies": [
      "python-docx>=1.1.0",
      "latex2mathml>=3.77.0",
      "PyYAML>=6.0",
      "mammoth>=1.6.0",
      "python-pptx>=0.6.21"
    ],
    "isolated_env": false
  },
  "mcp_dependencies": [
    {
      "server": "core-patents",
      "tools": ["search_patents", "bibliography", "legal_data", "family", "forward_citation"],
      "purpose": "专利著录检索、法律状态、同族与引证分析"
    },
    {
      "server": "patsnap-search",
      "tools": ["patsnap_search", "patsnap_fetch"],
      "purpose": "专利与文献语义检索（交底查新 Step 5）"
    },
    {
      "server": "patent-status",
      "tools": ["legal_data", "fee_info"],
      "purpose": "专利法律状态与年费核查"
    },
    {
      "server": "patent-landscape",
      "tools": ["search_patents_v3", "detail_aggregation", "trend"],
      "purpose": "专利全景分析（二期扩展）"
    },
    {
      "server": "patsnap-ip-searching",
      "tools": ["fto_review", "design_fto", "novelty_search", "get_task"],
      "purpose": "FTO 检索、外观设计 FTO、查新分析"
    },
    {
      "server": "novelty-search-lite",
      "tools": ["novelty_lite_search", "novelty_feature_extract", "novelty_feature_comparison", "novelty_lite_report_generate"],
      "purpose": "深度查新：特征提取、逐项对比与报告生成"
    },
    {
      "server": "patent-analysis",
      "tools": ["aggregate_patents", "mine_patent_text"],
      "purpose": "专利聚合统计与文本挖掘"
    },
    {
      "server": "patent-visual",
      "tools": ["trends", "applicant_ranking", "word_cloud"],
      "purpose": "可视化图表生成"
    }
  ],
  "tests": ["cli", "search_flow", "disclosure_flow", "landscape_flow", "fto_flow"],
  "outputs": [
    {
      "key": "search_report",
      "description": "著录检索结果 Markdown 报告",
      "path_pattern": "outputs/patent-search/SEARCH-*.md"
    },
    {
      "key": "disclosure_doc",
      "description": "交底书 Markdown + Word 文档",
      "path_pattern": "outputs/{case}/交底书_*.md"
    },
    {
      "key": "landscape_report",
      "description": "全景分析报告",
      "path_pattern": "outputs/patent-landscape/LANDSCAPE-*.md"
    },
    {
      "key": "fto_report",
      "description": "FTO 风险分析报告",
      "path_pattern": "outputs/patent-fto/FTO-*.md"
    }
  ]
}
